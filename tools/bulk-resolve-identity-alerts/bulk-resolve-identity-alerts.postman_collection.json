{
  "info": {
    "_postman_id": "4002a236-c63b-42a9-b69d-87746388fa60",
    "name": "SentinelOne GraphQL Resolve Alerts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "3229215"
  },
  "item": [
    {
      "name": "Resolve Identity Alerts",
      "item": [
        {
          "name": "getAlertIds",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Request completed\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "// Uncoment to print the raw response to the console",
                  "// console.log(\"Raw response:\", pm.response.text());",
                  "",
                  "if (!response.data) {",
                  "    console.log(\"ERROR: No data field in response\");",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "if (!response.data.alerts) {",
                  "    console.log(\"ERROR: No alerts field in response.data\");",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "if (!response.data.alerts.edges) {",
                  "    console.log(\"ERROR: No edges field in response.data.alerts\");",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "const edges = response.data.alerts.edges;",
                  "console.log(`Found ${edges.length} edges`);",
                  "",
                  "if (edges.length === 0) {",
                  "    console.log(\"No more alerts to process. Done!\");",
                  "    pm.execution.setNextRequest(null);",
                  "    return;",
                  "}",
                  "",
                  "const ids = edges.map(e => e.node.id);",
                  "pm.collectionVariables.set(\"alertIds\", JSON.stringify(ids));",
                  "pm.collectionVariables.set(\"hasNextPage\", response.data.alerts.pageInfo.hasNextPage);",
                  "",
                  "console.log(`Fetched ${ids.length} alert IDs. Moving to mutation...`);",
                  "",
                  "// *** REPLACE THIS WITH YOUR EXACT REQUEST NAME FROM THE SIDEBAR ***",
                  "const mutationRequestName = \"resolveAlertBatch\";",
                  "console.log(`Jumping to: ${mutationRequestName}`);",
                  "pm.execution.setNextRequest(mutationRequestName);",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query getAlertIds ($scope_id: [ID!]!, $scope_type: ScopeType!){\n  alerts(\n    filters: [\n      { fieldId: \"detectionProduct\", stringEqual: { value: \"Identity\" } }\n      { fieldId: \"status\", stringEqual: { value: \"NEW\" } }\n    ]\n    scope: { scopeIds: $scope_id, scopeType: $scope_type }\n    first: 250\n  ) {\n    pageInfo {\n      hasNextPage\n      endCursor\n    }\n    edges {\n      node {\n        id\n      }\n    }\n  }\n}",
                "variables": "{ \n    \"scope_id\": [\"{{SCOPE_ID}}\"],\n    \"scope_type\": \"{{SCOPE_TYPE}}\"\n}"
              }
            },
            "url": {
              "raw": "{{URL}}/web/api/v2.1/unifiedalerts/graphql",
              "host": [
                "{{URL}}"
              ],
              "path": [
                "web",
                "api",
                "v2.1",
                "unifiedalerts",
                "graphql"
              ]
            }
          },
          "response": []
        },
        {
          "name": "resolveAlertBatch",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Request completed\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "",
                  "if (response.data?.alertTriggerActions) {",
                  "    const result = response.data.alertTriggerActions;",
                  "",
                  "    if (result.__typename === \"TriggerActionsError\") {",
                  "        console.log(\"Mutation error:\", JSON.stringify(result.errors));",
                  "        pm.execution.setNextRequest(null);",
                  "        return;",
                  "    }",
                  "",
                  "    const actions = result.actions || [];",
                  "    const numActions = actions.length;",
                  "",
                  "    const totalSuccess = actions.reduce((sum, a) => sum + (a.success?.length || 0), 0);",
                  "    const totalFailure = actions.reduce((sum, a) => sum + (a.failure?.length || 0), 0);",
                  "    const totalSkip = actions.reduce((sum, a) => sum + (a.skip?.length || 0), 0);",
                  "",
                  "    // Divide by number of actions to get actual alert count",
                  "    const alertsResolved = totalSuccess / numActions;",
                  "    const alertsFailed = totalFailure / numActions;",
                  "    const alertsSkipped = totalSkip / numActions;",
                  "",
                  "    console.log(`Alerts resolved: ${alertsResolved} | Failed: ${alertsFailed} | Skipped: ${alertsSkipped}`);",
                  "",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Console Log that we are starting resolveAlertBatch",
                  "const mutationRequestName = \"resolveAlertBatch\";",
                  "console.log(`Starting execution inside: ${mutationRequestName}`);",
                  "",
                  "// Retrieve the stored IDs and scope details from collection variables",
                  "const ids = JSON.parse(pm.collectionVariables.get(\"alertIds\"));",
                  "console.log(`IDs received: ${ids.length}`);",
                  "const scope_id = pm.environment.get(\"SCOPE_ID\");",
                  "console.log(`Scope ID: ${scope_id}`);",
                  "const scope_type = pm.environment.get(\"SCOPE_TYPE\");",
                  "console.log(`Scope Type: ${scope_type}`);",
                  "",
                  "",
                  "// Build the or clauses dynamically from the IDs",
                  "const orClauses = ids.map(id => `",
                  "    {",
                  "      and: [",
                  "        { fieldId: \"id\", stringEqual: { value: \"${id}\" } }",
                  "      ]",
                  "    }",
                  "`).join(\",\");",
                  "",
                  "// Build the full mutation string",
                  "const mutation = `",
                  "mutation resolveAlertBatch {",
                  "  alertTriggerActions(",
                  "    filter: {",
                  "      or: [",
                  "        ${orClauses}",
                  "      ]",
                  "    }",
                  "    scope: { scopeIds: [\"${scope_id}\"], scopeType: ${scope_type} }",
                  "    actions: [",
                  "      { id: \"S1/alert/statusUpdate\", payload: { status: { value: RESOLVED } } }",
                  "      {",
                  "        id: \"S1/alert/analystVerdictUpdate\"",
                  "        payload: { analystVerdict: { value: FALSE_POSITIVE_USER_ERROR } }",
                  "      }",
                  "      {",
                  "        id: \"S1/alert/addNote\"",
                  "        payload: {",
                  "          note: {",
                  "            value: \"Alert bulk closed while addressing False Positives related to Over Pass-The-Hash attacks. Exclusions have been added for the False Positives and this alert will regenerate on next attempt.\"",
                  "          }",
                  "        }",
                  "      }",
                  "    ]",
                  "  ) {",
                  "    __typename",
                  "    ... on ActionsTriggered {",
                  "      actions {",
                  "        actionId",
                  "        success { id __typename }",
                  "        failure { id __typename }",
                  "        skip { id __typename }",
                  "        __typename",
                  "      }",
                  "    }",
                  "    ... on TriggerActionsError {",
                  "      errors {",
                  "        errorMessage",
                  "      }",
                  "    }",
                  "  }",
                  "}`;",
                  "",
                  "// Store the mutation as a collection variable and set it as the request body",
                  "pm.collectionVariables.set(\"mutationBody\", JSON.stringify({ query: mutation }));",
                  "console.log(\"Mutation body set successfully\");",
                  "console.log(\"resolveAlertBatch mutation now running...\")"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{{mutationBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL}}/web/api/v2.1/unifiedalerts/graphql",
              "host": [
                "{{URL}}"
              ],
              "path": [
                "web",
                "api",
                "v2.1",
                "unifiedalerts",
                "graphql"
              ]
            }
          },
          "response": []
        }
      ]
    }
